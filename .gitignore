# uv / Python
.venv/
# Dedicated framework-Python venv for the py2app build (setup.py) — py2app
# can't introspect uv's statically-linked managed Python, so this is built
# from a separate `brew install python@3.11` interpreter. Not the normal dev
# venv; recreated on demand, never committed.
.venv-py2app/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# uv lock file is intentionally committed — remove this line if you don't want that
# uv.lock

# Nuitka build artifacts
*.build/
*.dist/
*.onefile-build/
build_*.log
run_*.log

# Vendored CHIRP clone — its own git repo, pinned by commit and bundled at
# build time; not committed into the VRP repo. Clone it with:
#   git clone --depth=1 https://github.com/kk7ds/chirp.git
/chirp/

# CHIRP image files (radio memory dumps — personal data)
*.img

# Test cache
.pytest_cache/

# Disposable pytest --basetemp roots. Named per run (.test-tmp-phase6-full etc);
# some end up read-only, which makes `git status` warn on every invocation.
.test-tmp-*/

# Write-only GitHub token used to submit issues from the app (that feature is
# still to be built). Deliberately local-only — never commit a credential, even
# a write-only one.
.feedback.txt

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Dev run logs (grid preview, smoke output)
logs/

# Debug serial trace (written to CWD by main.py --debug during a clone)
serial-trace.txt

# Radio reverse-engineering artifacts (e.g. the KG-UV96M effort): USB/serial
# packet captures, CSV exports, process-id artifacts, and scratch analysis /
# screenshots. These hold personal radio data (channels/call signs) and are
# working files, not source — keep them local. (*.img already covered above.)
*.pcap
*.pid
*.png
csv.txt
_decoded.txt
_usbpcap.pid
